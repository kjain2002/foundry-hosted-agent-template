# Copy to .env (or set as azd environment values) and fill in YOUR values.
# Required: your Foundry project endpoint and model deployment name.
FOUNDRY_PROJECT_ENDPOINT="https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>"
AZURE_AI_MODEL_DEPLOYMENT_NAME="gpt-4.1"

# Tool wiring (optional). AGENT_TOOL_MODE: toolbox | code_interpreter | ci_container_toolbox | ci_client_container
AGENT_TOOL_MODE="ci_client_container"
CI_INCLUDE_TOOLBOX="1"

# Your MCP toolbox endpoint (required for any toolbox mode). Bring your own.
TOOLBOX_MCP_ENDPOINT="https://<your-foundry-account>.services.ai.azure.com/api/projects/<your-project>/toolboxes/<your-toolbox>/mcp?api-version=v1"